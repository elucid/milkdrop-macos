MILKDROP_PRESET_VERSION=201
PSVERSION_WARP=0
PSVERSION_COMP=2
[preset00]
// Original integration fixture, Copyright 2026 elucid, MIT license.
// Must animate an image from the external texture pack; no procedural fallback.
fDecay=0
fWaveAlpha=0
warp=0
comp_1=`shader_body
comp_2=`{
comp_3=`ret = tex2D(sampler_fw_paper, float2(uv.x + time*0.07, uv.y)).rgb;
comp_4=`}

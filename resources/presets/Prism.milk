MILKDROP_PRESET_VERSION=201
PSVERSION_WARP=0
PSVERSION_COMP=2
[preset00]
// Original preset, Copyright 2026 elucid, MIT license.
fDecay=0.950000
nWaveMode=7
bAdditiveWaves=1
bWaveThick=1
fWaveAlpha=0.800000
fWaveScale=1.800000
fWaveSmoothing=0.650000
fZoomExponent=1.000000
zoom=1.008000
warp=0.000000
wave_r=0.900000
wave_g=0.300000
wave_b=0.650000
wave_x=0.500000
wave_y=0.500000
per_frame_1=rot=0.005*cos(time*0.2);
per_frame_2=wave_r=0.7+0.3*sin(time*0.8);
per_frame_3=wave_b=0.65+0.35*cos(time*0.5);
comp_1=`shader_body
comp_2=`{
comp_3=`float3 base = tex2D(sampler_main, uv).rgb;
comp_4=`float glow = 0.025 + 0.025*sin(uv.x*18.0 + uv.y*12.0 + time);
comp_5=`ret = base + glow*float3(0.3, 0.15, 0.7);
comp_6=`}
